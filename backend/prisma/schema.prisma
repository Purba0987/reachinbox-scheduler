datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String?
  avatar           String?
  googleId         String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  slackIntegration SlackIntegration?
  emailJobs        EmailJob[]
}

model Sender {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  smtpHost  String     @default("smtp.ethereal.email")
  smtpPort  Int        @default(587)
  smtpUser  String
  smtpPass  String
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  emailJobs EmailJob[]
}

model EmailJob {
  id             String      @id @default(uuid())
  recipientEmail String
  subject        String
  body           String
  scheduledAt    DateTime
  sentAt         DateTime?
  status         EmailStatus @default(SCHEDULED)
  bullJobId      String?     @unique
  batchId        String?
  delaySeconds   Int         @default(2)
  hourlyLimit    Int         @default(20)
  priority       Int         @default(2)
  previewUrl     String?
  errorMessage   String?
  attemptCount   Int         @default(0)

  senderId       String?
  sender         Sender?     @relation(fields: [senderId], references: [id], onDelete: SetNull)

  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([recipientEmail])
  @@index([batchId])
  @@index([priority])
}

model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId      String?
  teamName    String?
  channelId   String?
  channelName String?
  webhookUrl  String?
  accessToken String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RateLimitEvent {
  id            String   @id @default(uuid())
  senderEmail   String
  hourWindow    String
  limitSet      Int
  slackNotified Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([senderEmail, hourWindow])
}

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL URL)
# Example Local: postgresql://postgres:password123@localhost:5432/reachinbox_scheduler?schema=public
# Example Cloud (Neon/Supabase): postgresql://user:pass@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:password123@localhost:5432/reachinbox_scheduler?schema=public"

# Redis (for BullMQ & Rate Limiter)
# Example Local: redis://localhost:6379
# Example Cloud (Upstash): rediss://default:token@xyz.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# Elasticsearch (Searchable Emails)
# Example Local: http://localhost:9200
ELASTICSEARCH_URL="http://localhost:9200"

# Default Ethereal Email Credentials (Generated via `npm run ethereal:create`)
ETHEREAL_USER=""
ETHEREAL_PASS=""
ETHEREAL_HOST="smtp.ethereal.email"
ETHEREAL_PORT=587

# Rate Limiting & Concurrency Settings
WORKER_CONCURRENCY=5
DEFAULT_DELAY_BETWEEN_EMAILS_SECONDS=2
DEFAULT_MAX_EMAILS_PER_HOUR_PER_SENDER=5

# Google OAuth (for token verification on backend)
GOOGLE_CLIENT_ID=""

# Slack Integration (OAuth or Webhook)
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:5000/api/slack/oauth/callback"
# Fallback direct webhook if testing without full OAuth app
SLACK_DEFAULT_WEBHOOK_URL=""
